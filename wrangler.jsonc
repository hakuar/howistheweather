{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "howistheweather",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./application/static",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "weather.hakuar.com", "custom_domain": true }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
